---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '两个人，原来是这样的',
  description = '一张只属于你们两个人的默契卡。各自填写，双方提交后一起揭晓。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e7" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
