{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "to-gather",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "to-gather",
      "database_id": "replace-with-production-d1-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "to-gather-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomCoordinator"]
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "APP_ENV": "production"
  }
}
