{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "to-gather",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "to-gather",
      "database_id": "ca27857a-7c0f-462b-8399-21cd02eae9bc",
      "migrations_dir": "migrations"
    },
    {
      "binding": "to_gather",
      "database_name": "to-gather",
      "database_id": "ca27857a-7c0f-462b-8399-21cd02eae9bc",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "to-gather-media"
    },
    {
      "bucket_name": "to-gather-media",
      "binding": "to_gather_media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomCoordinator"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "vars": {
    "APP_ENV": "production"
  }
}
